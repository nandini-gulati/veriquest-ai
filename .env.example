# Keep this file private: `.env` is ignored by git and is loaded by `inv` commands.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: enables cited Google web results alongside Wikipedia.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
